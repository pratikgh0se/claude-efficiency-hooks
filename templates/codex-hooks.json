{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/claude-efficiency-hooks/bash-cat-block.sh\"",
            "timeout": 30,
            "statusMessage": "Checking shell output size"
          }
        ]
      },
      {
        "matcher": "^(Grep|Glob|Read)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/claude-efficiency-hooks/graph-first-block.sh\"",
            "timeout": 30,
            "statusMessage": "Checking graph-first policy"
          }
        ]
      },
      {
        "matcher": "^Read$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/claude-efficiency-hooks/reread-warn.sh\"",
            "timeout": 30,
            "statusMessage": "Checking repeated reads"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/claude-efficiency-hooks/context-monitor-stop.sh\"",
            "timeout": 30,
            "statusMessage": "Checking context size"
          }
        ]
      }
    ]
  }
}
